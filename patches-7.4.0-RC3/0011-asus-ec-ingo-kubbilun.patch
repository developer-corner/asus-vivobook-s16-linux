--- a/drivers/hid/Kconfig
+++ b/drivers/hid/Kconfig
@@ -208,7 +208,7 @@ config HID_ASUS_EC
 	help
 	  Keyboard backlight (LED class asus::kbd_backlight) and Fn hotkeys
 	  for the EC-attached I2C-HID keyboards of the ASUS Zenbook A14
-	  (0B05:0220) and Vivobook S15 (0B05:4543).
+	  (0B05:0220) and Vivobook S15/S16 (0B05:4543).
 
 config HID_AUREAL
